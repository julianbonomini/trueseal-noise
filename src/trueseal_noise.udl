// trueseal_noise.udl — UniFFI interface definition for trueseal-noise
//
// Exposes Noise_XX_25519_ChaChaPoly_BLAKE2s and Noise_NK_25519_ChaChaPoly_BLAKE2s
// to Swift and Kotlin via a cdylib.
//
// Transport abstraction: callers supply a NoiseTransport object that bridges
// the Read+Write requirement across the language boundary.

namespace trueseal_noise {
    /// Generate a fresh X25519 keypair from a secure random source.
    KeypairRecord generate_keypair();

    /// Restore a keypair from raw private and public key bytes.
    KeypairRecord new_keypair([ByRef] sequence<u8> private_key, [ByRef] sequence<u8> public_key);

    /// Perform the XX handshake as the Initiator.
    /// `prologue` is mixed into the handshake hash; both peers must pass
    /// byte-identical prologues or the handshake fails on both sides. The
    /// caller owns its contents (for example a version prefix). Pass an
    /// empty sequence for no prologue.
    /// Blocks until the three-message handshake completes.
    /// Returns a fully-negotiated SessionXx on success.
    [Throws=NoiseError]
    SessionXx dial_xx(NoiseTransport transport, KeypairRecord keypair, [ByRef] sequence<u8> prologue);

    /// Perform the XX handshake as the Responder.
    /// `prologue` must be byte-identical to the Initiator's.
    /// Blocks until the three-message handshake completes.
    /// Returns a fully-negotiated SessionXx on success.
    [Throws=NoiseError]
    SessionXx accept_xx(NoiseTransport transport, KeypairRecord keypair, [ByRef] sequence<u8> prologue);

    /// Perform the NK handshake as the Initiator.
    /// `remote_static` is the Responder's known static public key — must be
    /// supplied before calling dial_nk.
    /// `prologue` is mixed into the handshake hash; both peers must pass
    /// byte-identical prologues or the handshake fails on both sides. The
    /// caller owns its contents (for example a version prefix). Pass an
    /// empty sequence for no prologue.
    /// Blocks until the two-message handshake completes.
    /// Returns a fully-negotiated SessionNk on success.
    [Throws=NoiseError]
    SessionNk dial_nk(NoiseTransport transport, KeypairRecord keypair, sequence<u8> remote_static, [ByRef] sequence<u8> prologue);

    /// Perform the NK handshake as the Responder.
    /// `prologue` must be byte-identical to the Initiator's.
    /// Blocks until the two-message handshake completes.
    /// Returns a fully-negotiated SessionNk on success.
    [Throws=NoiseError]
    SessionNk accept_nk(NoiseTransport transport, KeypairRecord keypair, [ByRef] sequence<u8> prologue);
};

/// A static X25519 keypair. public_key is safe to share freely.
/// private_key is sensitive key material — handle with care.
dictionary KeypairRecord {
    sequence<u8> public_key;
    sequence<u8> private_key;
};

/// NoiseTransport is a callback interface that the caller implements.
/// It bridges the Read+Write+Send requirement across the language boundary.
///
/// read() must block until exactly `count` bytes are available and return them.
/// write() must write all bytes and return only after the write is complete.
/// Both methods may throw NoiseError on I/O failure.
[Trait, WithForeign]
interface NoiseTransport {
    [Throws=NoiseError]
    sequence<u8> read(u64 count);

    [Throws=NoiseError]
    void write(sequence<u8> data);
};

/// A fully negotiated, bidirectional encrypted channel produced by the XX
/// Handshake Pattern. send and receive are safe to call concurrently.
/// remote_public_key() returns the authenticated static public key of the
/// remote peer unconditionally — mutual authentication is guaranteed by XX.
interface SessionXx {
    [Throws=NoiseError]
    void send([ByRef] sequence<u8> payload);

    [Throws=NoiseError]
    sequence<u8> receive();

    /// Returns the authenticated static public key of the remote peer.
    /// Always present — XX guarantees mutual authentication.
    sequence<u8> remote_public_key();

    [Throws=NoiseError]
    void close();
};

/// A fully negotiated, bidirectional encrypted channel produced by the NK
/// Handshake Pattern. send and receive are safe to call concurrently.
/// remote_public_key() is absent — the Initiator is anonymous by design and
/// the Initiator already knew the Responder's key before the handshake.
interface SessionNk {
    [Throws=NoiseError]
    void send([ByRef] sequence<u8> payload);

    [Throws=NoiseError]
    sequence<u8> receive();

    [Throws=NoiseError]
    void close();
};

/// Errors returned by the trueseal-noise API.
[Error]
interface NoiseError {
    Transport(string message);
    Handshake(string message);
    Closed();
    PayloadTooLarge();
};
